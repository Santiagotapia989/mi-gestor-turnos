{
  "name": "Nuevo Turno - Reserva",
  "nodes": [
    {
      "parameters": {},
      "id": "webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "nuevo-turno",
      "path": "nuevo-turno"
    },
    {
      "parameters": {
        "operation": "append",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "A": "={{ $json.servicio }}",
            "B": "={{ $json.servicioId }}",
            "C": "={{ $json.fecha }}",
            "D": "={{ $json.hora }}",
            "E": "={{ $json.duracion }}",
            "F": "={{ $json.precio }}",
            "G": "={{ $json.clienteNombre }}",
            "H": "={{ $json.clienteEmail }}",
            "I": "={{ $json.clienteTelefono }}",
            "J": "={{ $json.notas }}",
            "K": "={{ $json.fechaCreacion }}"
          }
        },
        "options": {}
      },
      "id": "sheets",
      "name": "Google Sheets - Guardar Reserva",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [500, 300],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REEMPLAZAR_CON_ID_CREDENCIAL_SHEETS",
          "name": "Google Sheets OAuth2 API"
        }
      }
    },
    {
      "parameters": {
        "operation": "send",
        "to": "={{ $json.clienteEmail }}",
        "subject": "Confirmación de reserva - {{ $json.servicio }}",
        "text": "Hola {{ $json.clienteNombre }},\n\nTu reserva ha sido confirmada:\n\n- Servicio: {{ $json.servicio }}\n- Fecha: {{ $json.fecha }}\n- Hora: {{ $json.hora }}\n- Duración: {{ $json.duracion }} minutos\n- Precio: ${{ $json.precio }}\n\nTe esperamos. ¡Gracias!\n\nEquipo de Gestión de Turnos",
        "options": {}
      },
      "id": "gmail",
      "name": "Gmail - Confirmación",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [760, 300],
      "credentials": {
        "gmailOAuth2": {
          "id": "REEMPLAZAR_CON_ID_CREDENCIAL_GMAIL",
          "name": "Gmail OAuth2 API"
        }
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Google Sheets - Guardar Reserva",
            "type": "main",
            "index": 0
          },
          {
            "node": "Gmail - Confirmación",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": false
  }
}
