# Base de datos PostgreSQL en la nube (Neon, Supabase, etc.)
# Obtén la connection string en console.neon.tech
DATABASE_URL=postgresql://usuario:contrasena@ep-tu-host.aws.neon.tech/db?sslmode=require

# API key de Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxx

# Remitente de los mails. Con el plan free usá tu email verificado o:
# "Acme <onboarding@resend.dev>"
EMAIL_FROM="Centro Medico Digital <onboarding@resend.dev>"